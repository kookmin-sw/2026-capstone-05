.item-description-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 150px;
    display: none;
}

.item-description-box {
    width: 520px;
    min-height: 232px;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/Assets/04_UI/UI/iteminfo_frame.png?fileID=21300000&guid=21391bbb8a8d1b44cabac7fd0476611e&type=3#iteminfo_frame");
    border-width: 0;
    padding: 0;
}

.item-description-header {
    display: none;
    background-color: transparent;
    height: 0;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin-bottom: 0;
}

.item-description-body {
    padding: 24px 34px 18px 34px;
}

.item-description-info {
    flex-direction: row;
    margin-bottom: 2px;
}

.item-description-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    background-size: contain;
}

.item-description-text {
    justify-content: center;
    flex-grow: 1;
}

.item-description-name {
    color: #ffffff;
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.item-description-price {
    color: #d9e2ef;
    font-size: 16px;
}

.item-description-shape-preview {
    align-items: center;
    justify-content: center;
    height: 50px;
    margin-bottom: 2px;
}

.item-description-shape-grid {
    position: relative;
}

.item-description-shape-cell {
    position: absolute;
    width: 14px;
    height: 14px;
    background-color: rgba(8, 13, 22, 0.65);
    border-width: 1px;
    border-color: rgba(120, 136, 158, 0.45);
}

.item-description-shape-cell--occupied {
    background-color: rgba(230, 240, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.75);
}

.item-description-quantity {
    color: #d9e2ef;
    font-size: 15px;
    width: 100%;
    margin-bottom: 6px;
    -unity-text-align: middle-right;
}

.item-description-desc {
    color: #ffffff;
    font-size: 15px;
    white-space: normal;
}
