  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ItemDescriptions_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 571fed7ee3a405d41b46396d5b7d9fd8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 38004502528
    m_Localized: "\uD0C1\uC0C1\uC6A9 \uC54C\uB78C\uC2DC\uACC4\uB2E4. \uB530\uB974\uB989\uAC70\uB9AC\uB294
      \uC18C\uB9AC\uAC00 \uC544\uCE68\uC744 \uAE68\uC6B0\uB294 \uC6A9\uB3C4\uB77C\uAE30\uC5D4
      \uC9C0\uB098\uCE58\uAC8C \uD06C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 558953836544
    m_Localized: "\uB2E8\uB2E8\uD558\uACE0 \uB0A0\uC774 \uC120 \uB3C4\uB07C\uC9C0\uB9CC
      \uB098\uBB34\uB97C \uBCA0\uC9C0\uB294 \uBABB\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 602960474112
    m_Localized: "\uBE44\uC5B4\uC788\uB294 \uC720\uB9AC\uBCD1\uC774\uB2E4. \uC548\uC5D0
      \uB9C8\uC2E4 \uAC8C \uC788\uC5C8\uB354\uB77C\uBA74\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 620899512320
    m_Localized: "\uC7A5\uBAA8\uB2D8\uC774 \uC0AC\uC8FC\uC2E0 \uB531\uB531\uD55C
      \uBE75\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1125700775936
    m_Localized: "\uB180\uB78D\uAC8C\uB3C4 \uB9C8\uC2E4 \uC218 \uC788\uB294 \uBB3C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1106193068032
    m_Localized: "\uB9C8\uC2DC\uBA74 \uAE30\uBD84\uC774 \uC88B\uC544\uC9C0\uB294
      \uD3C9\uBC94\uD55C \uBB3C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1081874493440
    m_Localized: "\uAF2D \uD544\uC694\uD560 \uB54C\uB9CC \uC5C6\uC5B4\uC9C0\uB294
      \uB450\uB8E8\uB9C8\uB9AC \uD734\uC9C0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 570282651648
    m_Localized: "\uC774 \uBD95\uB300\uB97C \uAC10\uC558\uB2E4\uAC04 \uAC10\uC5FC\uB420
      \uAC83 \uAC19\uC9C0\uB9CC \uC548 \uC4F0\uB294 \uAC83\uBCF4\uB2E4\uB294 \uB0AB\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 684753596416
    m_Localized: "\uAC08 \uB550 \uAC00\uB354\uB77C\uB3C4 \uB2F4\uBC30 \uD55C \uB300
      \uC815\uB3C8 \uAD1C\uCC2E\uC544 \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 638985351168
    m_Localized: "\uCD1D\uC744 \uC3D8\uAE30 \uC704\uD574 \uD544\uC694\uD55C \uCD1D\uC54C\uC774\uB2E4.
      \uCD1D\uC54C\uAC19\uC740 \uBE60\uB974\uAE30\uB97C \uC790\uB791\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 757851926528
    m_Localized: "\uB2E8\uBC31\uC9C8\uC774 \uC591\uAECF \uB4E4\uC5B4\uC788\uB294
      \uD37D\uD37D\uD55C \uC5D0\uB108\uC9C0\uBC14\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 865448407040
    m_Localized: "\uB530\uB73B\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1147154640896
    m_Localized: "\uBAA8\uB450\uC5D0\uAC8C \uACF5\uD3C9\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 590822158336
    m_Localized: "\uC77D\uC73C\uBA74 \uC9C0\uD61C\uB97C \uC5BB\uC744 \uC218 \uC788\uB294
      \uCC45\uC774\uB2E4. \uC544\uB2C8\uBA74 \uB554\uAC10\uC73C\uB85C \uC4F8 \uC218\uB3C4
      \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 715841777664
    m_Localized: "\uD3C9\uBC94\uD55C \uB098\uCE68\uBC18\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 738679762944
    m_Localized: "\uBB34\uC5B8\uAC00\uB97C \uD3ED\uD30C\uC2DC\uD0AC \uB54C \uC720\uC6A9\uD55C
      \uD3ED\uD0C4\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 788281602048
    m_Localized: "\uC704\uAE09\uD560 \uB54C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC9C0\uB9CC,
      \uC0AC\uC6A9\uD560 \uC77C\uC774 \uC5C6\uB294 \uAC8C \uAC00\uC7A5 \uC88B\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 817184550912
    m_Localized: "\uC190\uC804\uB4F1\uB9CC \uC788\uB2E4\uBA74 \uC5B4\uB5A4 \uC5B4\uB460\uB3C4
      \uB450\uB835\uC9C0 \uC54A\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 847576477696
    m_Localized: "\uAE30\uB984\uC774 \uAC00\uB4DD \uB4E4\uC5B4\uC788\uB294 \uC5F0\uB8CC\uD1B5\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 882787659776
    m_Localized: "\uBCF4\uAE30\uC640\uB294 \uB2E4\uB974\uAC8C \uACE0\uCCA0 \uB369\uC5B4\uB9AC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 903574630400
    m_Localized: "\uC660\uC9C0 \uD654\uBD84 \uBC11\uC5D0\uC11C \uBC1C\uACAC\uD560
      \uAC83\uB9CC \uAC19\uC740 \uC5F4\uC1E0."
    m_Metadata:
      m_Items: []
  - m_Id: 914454654976
    m_Localized: "\uBD88\uC744 \uBC1D\uD790 \uC218 \uC788\uB294 \uC9C0\uD3EC\uB77C\uC774\uD130."
    m_Metadata:
      m_Items: []
  - m_Id: 926693634048
    m_Localized: "\uD574\uC801\uC774 \uC88B\uC544\uD560 \uAC83 \uAC19\uC774 \uC0DD\uACBC\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 946234896384
    m_Localized: "\uD568\uAED8 \uBA39\uC744 \uC218 \uC788\uB294 \uBB3C\uC774 \uC788\uC5C8\uB2E4\uBA74
      \uB354 \uC88B\uC558\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 978380042240
    m_Localized: "\uD305\uD305\uD0F1\uD0F1 \uD6C4\uB77C\uC774\uD32C\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 988953882624
    m_Localized: "\uC5B4\uB518\uAC00\uB85C \uCD9C\uC785\uD560 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1006888726528
    m_Localized: "\uC624\uB798\uB418\uC5B4 \uBCF4\uC774\uC9C0\uB9CC \uC544\uC9C1
      \uC791\uB3D9\uD55C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1023552696320
    m_Localized: "\uADF8\uB9BD\uAC10\uC774 \uB358\uC9C0\uAE30 \uB531 \uC88B\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1038127902720
    m_Localized: "\uC720\uBA85\uD55C \uBE0C\uB79C\uB4DC\uC758 \uAC10\uC790\uCE69\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1060735201280
    m_Localized: "\uCE94\uB530\uAC1C\uAC00 \uD544\uC694\uC5C6\uC5B4\uC11C \uBA39\uAE30
      \uD3B8\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1172349825024
    m_Localized: "\uC4F8\uBAA8\uAC00 \uC788\uC744 \uBC95\uD55C \uB098\uBB34 \uD310\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 1192386015232
    m_Localized: "\uC4F8\uBAA8\uAC00 \uC788\uC744 \uBC95\uD55C \uB098\uBB34 \uD310\uC790
      \uB354\uBBF8."
    m_Metadata:
      m_Items: []
  - m_Id: 244026354479104
    m_Localized: "\uC606\uC5D0 \uC788\uC73C\uBA74 \uACC4\uC18D \uBA39\uAC8C \uB418\uB294
      \uC721\uD3EC."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
