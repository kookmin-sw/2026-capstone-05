/* ShopView.uss */

.shop-container {
    width: 100%;
    height: 100%;
    background-color: transparent; /* Dark brown border (moved to separate background document) */
    padding: 8px;
    font-family: "Pixel"; /* Assuming a pixel font is used */
    font-size: 16px;
    color: white;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.title-container {
    flex-direction: row;
    align-items: center;
}

.title-icon {
    width: 24px;
    height: 24px;
    background-color: #ffd700;
    border-radius: 12px;
    margin-right: 8px;
}

.shop-title {
    font-size: 20px;
    color: #f5e4c3;
    -unity-font-style: bold;
}

.gold-container {
    background-color: #1c1c1c;
    border-width: 2px;
    border-color: #ffffff;
    border-radius: 4px;
    padding: 4px 12px;
}

.gold-text {
    color: #ffd700;
    font-size: 18px;
}

.main-content {
    flex-direction: row;
    flex-grow: 1;
}

/* LEFT PANEL */
.left-panel {
    flex-grow: 1;
    width: 50%;
    background-color: #e6c89a; /* Light tan inner bg */
    border-width: 4px;
    border-color: #8c5b3f; /* Border for the items area */
    border-radius: 8px;
    padding: 8px;
    position: relative;
    overflow: visible;
}

.catalog-scroll {
    flex-grow: 1;
}

.catalog-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 12px;
}

.placement-grid-container {
    flex-grow: 1;
    background-color: #000000; /* Black bg for grid */
    border-width: 2px;
    border-color: #5b3e31;
    overflow: visible;
    /* align-items: center; */
    /* justify-content: center; */
}

.placement-grid {
    /* To be controlled by code, like GridInventoryView */
}

/* RIGHT PANEL */
.right-panel {
    flex-grow: 1;
    width: 50%;
    margin-left: 8px;
    justify-content: flex-end;
    align-items: center;
    background-color: transparent; /* Assuming duck is drawn or an image is set */
}

.npc-container {
    flex-grow: 1;
    width: 100%;
    justify-content: center;
    align-items: center;
}

.npc-image {
    width: 200px;
    height: 200px;
    /* Set Duck sprite from code */
}

.dialogue-container {
    width: 100%;
    background-color: #000000;
    border-width: 4px;
    border-color: #ffffff;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 8px;
    min-height: 100px;
}

.dialogue-text {
    color: white;
    font-size: 18px;
    white-space: normal;
}

.action-buttons {
    flex-direction: row;
    width: 100%;
    justify-content: space-around;
    background-color: #000000;
    border-width: 4px;
    border-color: #d19a4e; /* Brownish border */
    border-radius: 8px;
    padding: 8px;
}

.action-btn {
    background-color: transparent;
    border-width: 0;
    color: #a0a0a0;
    font-size: 18px;
    cursor: pointer;
}

.action-btn:hover {
    color: white;
}

.action-btn.active {
    color: #ffd700; /* Gold */
}

/* ITEM CARD */
.item-card {
    width: 250px; /* 한 줄에 3개씩 들어갈 수 있는 적절한 고정 픽셀 크기 */
    height: 250px; /* 카드 높이 */
    background-color: #fff4d2;
    border-width: 6px;
    border-color: #b08d6a;
    border-radius: 8px;
    margin: 10px; /* 고정 여백 픽셀 */
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
}

.item-card:hover {
    background-color: #ffffff;
}

.card-shape-preview {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 32px;
    height: 32px;
    /* Drawn dynamically or with small cells */
}

.card-icon {
    width: 120px; /* 아이콘 크기 증가 */
    height: 120px;
    margin-bottom: 12px;
}

.card-name {
    color: #000000;
    font-size: 26px; /* 폰트 크기 증가 */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.card-price {
    color: #000000;
    font-size: 24px; /* 폰트 크기 증가 */
    -unity-text-align: middle-center;
}

/* POPUP OVERLAY */
.popup-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.popup-box {
    width: 260px;
    background-color: #e6c89a;
    border-width: 4px;
    border-color: #8c5b3f;
    border-radius: 8px;
}

.popup-header {
    background-color: #8c5b3f;
    padding: 4px;
}

.popup-title {
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.popup-body {
    padding: 12px;
}

.popup-item-info {
    flex-direction: row;
    margin-bottom: 8px;
}

.popup-icon {
    width: 48px;
    height: 48px;
    margin-right: 8px;
}

.popup-item-text {
    justify-content: center;
}

.popup-item-name {
    color: #000000;
    font-size: 16px;
    -unity-font-style: bold;
}

.popup-item-price {
    color: #000000;
    font-size: 14px;
}

.popup-shape-preview {
    align-items: center;
    margin-bottom: 8px;
    height: 80px;
    justify-content: center;
}

.shape-grid {
    /* Dynamically created small cells */
}

.popup-desc {
    color: #000000;
    font-size: 12px;
    white-space: normal;
}

.popup-footer {
    flex-direction: row;
    padding: 8px;
    justify-content: space-around;
}

.popup-btn {
    border-width: 2px;
    border-color: #8c5b3f;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 14px;
    cursor: pointer;
    -unity-text-align: middle-center;
}

.popup-btn-confirm {
    background-color: #8fb935; /* Greenish */
    color: white;
}

.popup-btn-cancel {
    background-color: #c94c4c; /* Redish */
    color: white;
}
