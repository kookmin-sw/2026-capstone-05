:root {
}

/* 1920x1080 픽셀 기준 고정 캔버스 */
.main-container {
    width: 1920px;
    height: 1080px;
    position: absolute;
    left: 0px;
    top: 0px;
}

/* 중앙 퀵슬롯 패널 */
.bottom-center-panel {
    position: absolute;
    left: 770px; /* 정중앙 근처 픽셀수동 지정 */
    top: 990px;
    width: 400px;
    height: 70px;
    flex-direction: row;
}

.quickslot {
    width: 60px;
    height: 60px;
    margin-right: 10px;
    background-color: rgba(10, 15, 25, 0.8);
    border-width: 2px;
    border-color: rgba(150, 150, 180, 0.8);
    border-radius: 5px;
    position: absolute;
}

.quickslot-number {
    position: absolute;
    top: 5px;
    right: 5px;
    font-size: 12px;
    color: white;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 4px;
    -unity-font-style: bold;
}


