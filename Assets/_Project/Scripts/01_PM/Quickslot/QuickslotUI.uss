:root {
}

/* Fixed 1920x1080 canvas. */
.main-container {
    width: 1920px;
    height: 1080px;
    position: absolute;
    left: 0px;
    top: 0px;
}

/* Bottom-center quickslot panel. */
.bottom-center-panel {
    position: absolute;
    left: 813px;
    top: 984px;
    width: 294px;
    height: 76px;
    flex-direction: row;
}

.quickslot {
    width: 66px;
    height: 66px;
    margin-right: 10px;
    background-color: rgba(10, 15, 25, 0.8);
    border-width: 2px;
    border-color: rgba(150, 150, 180, 0.8);
    border-radius: 5px;
    position: absolute;
}

.quickslot-number {
    position: absolute;
    top: 5px;
    right: 5px;
    font-size: 13px;
    color: white;
    background-color: rgba(0, 0, 0, 0.8);
    padding: 2px 4px;
    -unity-font-style: bold;
}
