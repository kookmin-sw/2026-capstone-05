/* LootUI.uss */
.loot-container {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.2);
    align-items: stretch;
    justify-content: stretch;
    color: rgb(220, 220, 220);
    -unity-font: url("project://database/Assets/_Project/Assets/04_UI/Fonts/NEXON%20Lv2%20Gothic%20OTF%20Bold.otf?fileID=12800000&guid=24429f7fd4d47fd4f9488bfd2ea0de38&type=3#NEXON Lv2 Gothic OTF Bold");
    -unity-font-definition: initial;
}

.split-container {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    width: 100%;
    height: 100%;
}

.loot-left-panel {
    width: 35%;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/Assets/04_UI/UI/popup.png?fileID=21300000&guid=d377e82806aac4a4088e123845017d41&type=3#popup");
    border-width: 0;
    padding: 40px;
    flex-direction: column;
    height: 100%;
}

.loot-center-panel {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.loot-right-panel {
    width: 35%;
    background-color: transparent;
    background-image: url("project://database/Assets/_Project/Assets/04_UI/UI/popup.png?fileID=21300000&guid=d377e82806aac4a4088e123845017d41&type=3#popup");
    border-width: 0;
    padding: 40px;
    flex-direction: column;
    height: 100%;
}

.header-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    padding-bottom: 0px;
}

.header-text {
    font-size: 28px;
    color: white;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.slots-scroll-view {
    flex-grow: 1;
    margin-bottom: 16px;
    background-color: transparent;
    border-radius: 8px;
    padding: 8px 16px 16px 16px;
}

.slots-scroll-view .unity-scroll-view__content-container {
    align-items: center;
    justify-content: flex-start;
    padding-top: 0px;
    min-width: 100%;
    min-height: 100%;
}

.slotsContainer {
    flex-wrap: wrap;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    background-color: transparent;
    padding: 0px;
    flex-shrink: 0;
    width: 100%;
}

/* Grid Inventory injection target */
.player-inventory-container {
    flex-grow: 1;
    align-items: stretch;
    justify-content: stretch;
}

.footer-container {
    align-items: flex-end;
    padding: 8px 16px;
}

.capacity-text {
    font-size: 14px;
    color: rgb(150, 150, 150);
}

/* Item Detail Panel */
.item-detail-container {
    width: 100%;
    background-color: transparent;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    padding: 16px;
    border-radius: 4px;
}

.detail-name {
    font-size: 22px;
    color: white;
    -unity-font-style: bold;
}

.detail-type {
    font-size: 14px;
    color: rgb(150, 150, 150);
    margin-bottom: 8px;
}

.detail-separator {
    height: 1px;
    background-color: rgb(80, 80, 80);
    margin-top: 8px;
    margin-bottom: 8px;
}

.detail-desc {
    font-size: 14px;
    color: rgb(200, 200, 200);
    white-space: normal;
}

/* Bottom Bar */
.bottom-bar {
    display: none;
    position: absolute;
    bottom: 24px;
    right: 40px;
    flex-direction: row;
    justify-content: flex-end;
}

.action-btn {
    background-color: rgb(40, 40, 40);
    color: white;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    padding: 8px 16px;
    margin-left: 12px;
    font-size: 16px;
    border-radius: 4px;
    cursor: default;
}

.action-btn:hover {
    background-color: rgb(80, 80, 80);
}

.ghostIcon {
    visibility: hidden;
    position: absolute;
    width: 100px;
    height: 100px;
    background-image: none;
    -unity-background-scale-mode: scale-to-fit;
}