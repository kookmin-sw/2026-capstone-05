<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:Systems="Systems.GridInventory" editor-extension-mode="False">
    <engine:Style src="LootUI.uss" />
    <engine:VisualElement name="loot-root" class="loot-container">
        
        <engine:VisualElement class="split-container">
                
                <!-- Left Panel : Loot / Chest -->
                <engine:VisualElement class="loot-left-panel">
                    <engine:VisualElement class="header-container">
                        <engine:Label name="loot-header" text="Supply Chest" class="header-text"/>
                    </engine:VisualElement>
                    
                    <engine:ScrollView class="slots-scroll-view" name="loot-scroll-view">
                        <engine:VisualElement name="lootSlotsContainer" class="slotsContainer" />
                    </engine:ScrollView>
                </engine:VisualElement>

                <!-- Center Panel : Item Description -->
                <engine:VisualElement class="loot-center-panel">
                    <engine:VisualElement name="item-detail-container" class="item-detail-container" style="display: none;">
                        <engine:Label name="detail-name" text="Item Name" class="detail-name"/>
                        <engine:Label name="detail-type" text="Type" class="detail-type"/>
                        <engine:VisualElement class="detail-separator" />
                        <engine:Label name="detail-desc" text="Item description goes here." class="detail-desc"/>
                    </engine:VisualElement>
                </engine:VisualElement>

                <!-- Right Panel : Player Inventory -->
                <engine:VisualElement class="loot-right-panel">
                    <engine:VisualElement class="header-container">
                        <engine:Label name="inventory-header" text="Inventory" class="header-text"/>
                    </engine:VisualElement>

                    <!-- The player inventory grid will be injected here via code -->
                    <engine:VisualElement name="player-inventory-container" class="player-inventory-container" />
                </engine:VisualElement>
                
            </engine:VisualElement>

            <!-- Bottom Bar for controls -->
            <engine:VisualElement class="bottom-bar">
                <engine:Button name="btn-take-all" text="* Take All" class="action-btn" />
                <engine:Button name="btn-close" text="* Close" class="action-btn" />
            </engine:VisualElement>
        
        <!-- Drag & Drop Ghost Icon -->
        <engine:VisualElement name="ghostIcon" class="ghostIcon"/>
        
    </engine:VisualElement>
</engine:UXML>